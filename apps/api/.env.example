# Public origin of this API (used for the Blink icon URL and Action responses)
# Local: http://localhost:3001
# Vercel Production: https://api-tidepay.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Where browsers are sent when they open a shareable /subscribe/<plan> link
# Local: http://localhost:3000
# Vercel Production: https://app-tidepay.vercel.app
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Public origin of the marketing / landing page
# Local: http://localhost:3002
# Vercel Production: https://tidepay.vercel.app
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# Solana RPC (defaults to the public devnet endpoint)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Gasless relayer. Server-only. Keypair as a JSON byte array, as written by
# `solana-keygen new`. Use a dedicated devnet key holding a little SOL; never
# reuse a key that holds real funds. Leave unset to disable sponsorship.
RELAYER_SECRET_KEY=

# Merchants whose plans the relayer will sponsor (comma-separated public
# keys). Sponsorship is off for every merchant not listed, so a stranger
# cannot drain the relayer by creating their own plan.
RELAYER_ALLOWED_MERCHANTS=
