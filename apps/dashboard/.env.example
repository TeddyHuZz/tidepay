# Public origin of the dashboard (checkout links and embed snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin of the Action/Blink API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solana RPC (defaults to the public devnet endpoint)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
