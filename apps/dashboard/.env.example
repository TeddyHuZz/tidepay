# Public origin used for Blink URLs, icons and embed snippets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana RPC (defaults to the public devnet endpoint)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Gasless relayer (E2-07). Server-only. Keypair as a JSON byte array, as
# written by `solana-keygen new`. Use a dedicated devnet key holding a little
# SOL; never reuse a key that holds real funds. Leave unset to disable
# sponsorship (the subscriber pays the network fee).
RELAYER_SECRET_KEY=

# Test only: let POST /api/actions/subscribe/[planId] return a Memo-only
# transaction before @tidepay/sdk is integrated. Moves no funds.
TIDEPAY_ACTIONS_MOCK_TX=
