# Public origin of the dashboard (checkout links and embed snippets)
# Local: http://localhost:3000
# Vercel Production: https://app-tidepay.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin of the Action/Blink API (apps/api). Checkout subscribes
# through the same endpoint the Blink uses.
# Local: http://localhost:3001
# Vercel Production: https://api-tidepay.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public origin of the marketing / landing page
# Local: http://localhost:3002
# Vercel Production: https://tidepay.vercel.app
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# Solana RPC (defaults to the public devnet endpoint)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Accepted mint for new plans (defaults to Circle's Devnet USDC)
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Plan address the /demo app checks for an active subscription. Leave unset
# to run /demo in mock mode.
NEXT_PUBLIC_DEMO_PLAN_ADDRESS=

# Set to 1 to show sample data instead of reading the chain (UI demos before
# the program is deployed).
NEXT_PUBLIC_USE_SAMPLE_DATA=
