# Solana RPC endpoint (Helius Devnet or Mainnet)
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=b1d15beb-4369-4887-a335-ebfbac4b1c91
# Fallback Solana RPC endpoint in case primary encounters DNS / network drops
SOLANA_FALLBACK_RPC_URL=https://api.devnet.solana.com

# Polling frequency in milliseconds (default: 15000 = 15s)
POLL_INTERVAL_MS=15000

# Keeper Keypair: For Railway/Render/Fly.io cloud deployments, provide the secret key directly
# Accepts JSON array (e.g. [1,2,3...]) or Base58 string
CRANK_SECRET_KEY=

# Local filesystem keypair path (falls back to ~/.config/solana/id.json if unset)
# CRANK_KEYPAIR_PATH=/path/to/keypair.json
